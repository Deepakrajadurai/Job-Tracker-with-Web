# Copy to .env (never commit it). Read automatically by every jobtracker command, on every OS.
GEMINI_API_KEY=
# Optional: mailbox that receives LinkedIn / Indeed / Xing job alert emails.
JOBTRACKER_IMAP_HOST=imap.gmail.com
JOBTRACKER_IMAP_USER=
JOBTRACKER_IMAP_PASSWORD=

# ---- Web interface (python -m jobtracker.web) ----
# Long random string. Signs login cookies and encrypts saved mailbox passwords. Keep it stable.
JOBTRACKER_SECRET_KEY=
# Public address of the site, needed for SSO behind a proxy.
# On the home server: the address that `tailscale serve status` prints, e.g. https://home-server.tail1234.ts.net
JOBTRACKER_BASE_URL=
# Set to 1 when the site runs on HTTPS (always in production).
JOBTRACKER_COOKIE_SECURE=0
# Daily run inside the web app. Set JOBTRACKER_SCHEDULER=0 if cron or Task Scheduler does it.
JOBTRACKER_SCHEDULER=1
JOBTRACKER_DAILY_AT=04:00
# Single sign-on. A provider appears on the login page when both of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any other OpenID Connect provider, e.g. Microsoft:
# OIDC_NAME=Microsoft
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ---- Nextcloud copy of the results ----
# Web users enter their own Nextcloud login under Settings. This address is only pre-filled there.
JOBTRACKER_NEXTCLOUD_DEFAULT_URL=
# For command line runs only (python -m jobtracker.run): copy CSV and Excel into this Nextcloud.
JOBTRACKER_NEXTCLOUD_URL=
JOBTRACKER_NEXTCLOUD_USER=
JOBTRACKER_NEXTCLOUD_PASSWORD=
JOBTRACKER_NEXTCLOUD_FOLDER=Job Tracker

# ---- Optional public access (Cloudflare Tunnel) ----
# COMPOSE_PROFILES=public
# TUNNEL_TOKEN=token-from-the-cloudflare-dashboard
